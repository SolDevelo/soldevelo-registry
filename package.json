{
  "name": "openlmis-registry",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "next typegen && tsc --noEmit",
    "registry:build": "pnpm exec tsx ./lib/build-registry.mts && pnpm exec shadcn build && pnpm exec tsx ./scripts/registry/finalize-artifacts.mts && pnpm registry:docs",
    "registry:docs": "pnpm exec tsx ./scripts/registry/gen-registry-md.mts && pnpm exec tsx ./scripts/registry/gen-llms-txt.mts",
    "registry:check": "pnpm registry:build && git diff --exit-code -- config registry.json public/r public/llms.txt REGISTRY.md"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.83.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=12"
  }
}
